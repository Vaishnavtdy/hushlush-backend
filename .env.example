# PostgreSQL connection string (Neon). Use the pooled connection string for serverless-friendly pooling.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign/verify session JWTs. Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-secret"

# IANA timezone used for all business-day attendance calculations.
APP_TIMEZONE="Asia/Kolkata"

# Origin of the deployed/running frontend, used for CORS + cookie settings.
FRONTEND_URL="http://localhost:3000"

# Port the Express server listens on.
PORT=4000

# "production" enables Secure+SameSite=None cookies required for cross-site requests (Vercel <-> Render).
NODE_ENV="development"
